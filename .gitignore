# ==========================================
# 2. Obsidian (Vault Configuration & Cache)
# ==========================================
# Изключваме временните работни файлове, за да не се блъскат при авто-синк на всеки 10 мин:
.obsidian/workspace
.obsidian/workspace.json
.obsidian/cache
.obsidian/cache.*
.obsidian/graph.json
.obsidian/graph-history.json
.obsidian/app.json
.obsidian/community-plugins.json
.obsidian/plugins/obsidian-git/data.json

# (По желание) Ако НЕ искаш да качваш изобщо инсталираните плъгини и теми 
# в GitHub, а само самите бележки (.md файловете) и картинките, разкоментирай долния ред:
# .obsidian/plugins/
# .obsidian/themes/

